# ---------------------------------------------------------------------------
# GOS-IP environment. Copy to .env.local for development. Never commit secrets.
# ---------------------------------------------------------------------------

# PostgreSQL + PostGIS connection (Supabase: Project Settings -> Database ->
# Connection string; use the transaction pooler URI on Vercel).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gosip
DATABASE_POOL_MAX=5

# Session signing secret (>= 32 random characters). openssl rand -base64 48
SESSION_SECRET=
# Optional: separate secret for hashing submitter fingerprints (defaults to SESSION_SECRET)
FINGERPRINT_SECRET=

# AI provider: Groq (server-side only). Create a key at https://console.groq.com/keys
# Without a key, investigations are recorded as "AI not configured" and routed
# to human review — nothing is faked.
GROQ_API_KEY=
# Text agents (A, C, D, E, F). Must support JSON output; json_schema preferred.
AI_MODEL=openai/gpt-oss-120b
# Evidence agent (B) receives images: must be a Groq vision-capable model.
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_AGENT_TIMEOUT_MS=90000
AI_AGENT_MAX_ATTEMPTS=3

# Supabase (Storage for evidence; Realtime for live updates)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=evidence
# Local development only (ignored when Supabase Storage is configured)
LOCAL_UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_FILES=5

# Correlation engine
CLUSTER_RADIUS_KM=8
CLUSTER_WINDOW_HOURS=48
CLUSTER_THRESHOLD=0.55

# Maps (defaults: CARTO dark raster on OpenStreetMap data, OpenFreeMap glyphs)
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_GLYPHS_URL=
NEXT_PUBLIC_MAP_FONT=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo deployments: allow submissions explicitly labelled as synthetic demo data
DEMO_MODE=false
