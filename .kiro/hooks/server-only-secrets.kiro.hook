{
  "enabled": true,
  "name": "Secret exposure check",
  "description": "When client components change, make sure no server-only module or secret leaks to the browser.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/app/**/*.tsx", "src/components/**/*.tsx"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the edited client files: they must not import from src/lib/config, src/lib/db, src/lib/services, src/lib/ai or src/lib/storage, and must not reference GROQ_API_KEY, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL or SESSION_SECRET. Only NEXT_PUBLIC_* variables may be read in the browser. Run `npm run typecheck` and `npm run lint`."
  }
}
